
import java.util.Scanner;

public class FirstFit {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        // Step 1: Accept number of memory blocks
        System.out.print("Enter number of memory blocks: ");
        int n = sc.nextInt();

        int[] block = new int[n];

        // Step 2: Accept memory block sizes
        System.out.println("Enter block sizes:");
        for (int i = 0; i < n; i++) {
            block[i] = sc.nextInt();
        }

        // Step 3: Accept number of processes
        System.out.print("Enter number of processes: ");
        int m = sc.nextInt();

        int[] process = new int[m];
        int[] allocation = new int[m];

        // Step 4: Accept process sizes
        System.out.println("Enter process sizes:");
        for (int i = 0; i < m; i++) {
            process[i] = sc.nextInt();
            allocation[i] = -1;
        }

        // Step 5: First Fit allocation
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {

                // Check if block has enough available memory
                if (block[j] >= process[i]) {

                    allocation[i] = j;
                    block[j] = block[j] - process[i];

                    break;
                }
            }
        }

        // Step 6: Display allocation result
        System.out.println("\nProcess\tSize\tBlock");

        for (int i = 0; i < m; i++) {
            System.out.print("P" + (i + 1) + "\t");
            System.out.print(process[i] + "\t");

            if (allocation[i] != -1) {
                System.out.println(allocation[i] + 1);
            } else {
                System.out.println("Not Allocated");
            }
        }

        sc.close();
    }
}
